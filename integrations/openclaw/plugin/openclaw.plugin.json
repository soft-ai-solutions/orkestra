{
  "id": "orkestra-bridge",
  "name": "Orkestra bridge",
  "description": "Telegram → orkestra: /run (/yap), /runs (/durum), /cancel (/iptal), /ide, plain-language requests through the orkestra_run tool, owner commands (passphrase), reply-to-answer and job notifications.",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "orkestra_run",
      "orkestra_status"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "chatId"
    ],
    "properties": {
      "chatId": {
        "type": "string",
        "pattern": "^-?[0-9]+$"
      },
      "clientPath": {
        "type": "string"
      },
      "orkestraCliPath": {
        "type": "string"
      },
      "python": {
        "type": "string"
      },
      "pollSeconds": {
        "type": "number",
        "minimum": 5,
        "maximum": 300
      },
      "ownerCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "salt",
          "sha256",
          "words"
        ],
        "properties": {
          "salt": {
            "type": "string",
            "minLength": 16
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "words": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        }
      },
      "ideApps": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,59}$"
        },
        "maxItems": 8
      }
    }
  }
}
